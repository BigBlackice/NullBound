{
  "schema_version": 1,
  "modules": [
    {
      "id": "01",
      "eyebrow": "discovery",
      "icon": "travel_explore",
      "description": "Subdomain Intel",
      "bin": "subfinder",
      "path": "subfinder",
      "adapter": "subfinder",
      "target_summary": "ADD TARGET",
      "target_placeholder": "domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Standard passive",
          "options": [
            {"label": "Mode", "value": "PASSIVE"},
            {"label": "Sources", "value": "DEFAULT"}
          ],
          "arguments": ["-dL", "{target_file}"],
          "output_format": "jsonl"
        },
        {
          "name": "Broad passive",
          "options": [
            {"label": "Sources", "value": "ALL"},
            {"label": "Runtime", "value": "SLOWER"}
          ],
          "arguments": ["-dL", "{target_file}", "-all"],
          "output_format": "jsonl"
        },
        {
          "name": "Recursive passive",
          "arguments": ["-dL", "{target_file}", "-recursive"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "02",
      "eyebrow": "dns",
      "icon": "dns",
      "description": "Resolve Records",
      "bin": "dnsx",
      "path": "dnsx",
      "adapter": "dnsx",
      "config_fields": [
        {
          "id": "resolver",
          "label": "DNS RESOLVER",
          "argument": "-r",
          "placeholder": "dns resolver (optional)"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Standard resolution",
          "options": [
            {"label": "A / AAAA", "value": "ENABLED"},
            {"label": "CNAME", "value": "ENABLED"}
          ],
          "arguments": ["-l", "{target_file}", "-a", "-aaaa", "-cname"],
          "output_format": "jsonl"
        },
        {
          "name": "All records",
          "arguments": ["-l", "{target_file}", "-recon"],
          "output_format": "jsonl"
        },
        {
          "name": "Authority records",
          "arguments": ["-l", "{target_file}", "-ns", "-soa"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "03",
      "eyebrow": "network",
      "icon": "radar",
      "description": "Port Discovery",
      "bin": "nmap",
      "path": "nmap",
      "adapter": "nmap",
      "target_summary": "ADD TARGET",
      "target_placeholder": "IP/Host/CIDR",
      "state": "READY",
      "profiles": [
        {
          "name": "Top 1000 TCP",
          "options": [
            {"label": "Scan", "value": "TCP CONNECT"},
            {"label": "Ports", "value": "TOP 1000"}
          ],
          "arguments": ["-sT", "--top-ports", "1000", "--reason", "{targets}"],
          "output_format": "xml"
        },
        {
          "name": "Web ports",
          "arguments": ["-sT", "-p", "80,443,8080,8443", "--reason", "{targets}"],
          "output_format": "xml"
        },
        {
          "name": "Service detection",
          "arguments": ["-sT", "-sV", "--version-light", "--reason", "{targets}"],
          "output_format": "xml"
        }
      ]
    },
    {
      "id": "04",
      "eyebrow": "http",
      "icon": "http",
      "description": "Web Probe",
      "bin": "httpx",
      "path": "httpx",
      "adapter": "httpx",
      "config_fields": [
        {
          "id": "resolver",
          "label": "DNS RESOLVER",
          "argument": "-r",
          "placeholder": "optional / e.g. udp:10.64.0.1:53"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "URL/Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Standard web metadata",
          "options": [
            {"label": "Follow redirects", "value": "ENABLED"},
            {"label": "Capture title", "value": "ENABLED"},
            {"label": "Concurrency", "value": "25"}
          ],
          "arguments": ["-u", "{target}", "-title", "-tech-detect", "-fr", "-json"],
          "output_format": "jsonl"
        },
        {
          "name": "Light probe",
          "arguments": ["-u", "{target}", "-status-code", "-title", "-json"],
          "output_format": "jsonl"
        },
        {
          "name": "Extended fingerprint",
          "arguments": ["-u", "{target}", "-status-code", "-title", "-tech-detect", "-web-server", "-ip", "-cname", "-asn", "-cdn", "-location", "-fr", "-json"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "05",
      "eyebrow": "archive",
      "icon": "history",
      "description": "Known URLs",
      "bin": "gau",
      "path": "gau",
      "adapter": "gau",
      "target_summary": "ADD TARGET",
      "target_placeholder": "Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Common providers",
          "options": [
            {"label": "Subdomains", "value": "ENABLED"},
            {"label": "Parameters", "value": "FOLDED"},
            {"label": "Providers", "value": "ALL"}
          ],
          "arguments": ["--subs", "--fp", "{targets}"],
          "output_format": "jsonl"
        },
        {
          "name": "Wayback only",
          "arguments": ["--providers", "wayback", "{targets}"],
          "output_format": "jsonl"
        },
        {
          "name": "Broad collection",
          "arguments": ["--subs", "{targets}"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "06",
      "eyebrow": "tls",
      "icon": "verified_user",
      "description": "TLS Inspect",
      "bin": "tlsx",
      "path": "tlsx",
      "adapter": "tlsx",
      "config_fields": [
        {
          "id": "resolver",
          "label": "DNS RESOLVER",
          "argument": "-r",
          "placeholder": "dns resolver (optional)"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Certificate summary",
          "options": [
            {"label": "Certificate names", "value": "ENABLED"},
            {"label": "TLS version", "value": "ENABLED"}
          ],
          "arguments": ["-u", "{target}", "-san", "-cn", "-so", "-tls-version", "-cipher"],
          "output_format": "jsonl"
        },
        {
          "name": "Protocol inventory",
          "arguments": ["-u", "{target}", "-version-enum", "-cipher"],
          "output_format": "jsonl"
        },
        {
          "name": "Full TLS metadata",
          "arguments": ["-u", "{target}", "-san", "-cn", "-so", "-tls-version", "-cipher", "-hash", "sha256", "-serial", "-cert", "-tls-chain"],
          "output_format": "jsonl"
        }
      ]
    }
  ]
}

{
  "schema_version": 1,
  "modules": [
    {
      "id": "01",
      "eyebrow": "discovery",
      "icon": "travel_explore",
      "description": "Subdomain Intel",
      "summary": "Enumerate subdomains from passive sources",
      "bin": "subfinder",
      "path": "subfinder",
      "adapter": "subfinder",
      "target_summary": "ADD TARGET",
      "target_placeholder": "domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Standard passive",
          "options": [
            {"label": "Mode", "value": "PASSIVE"},
            {"label": "Sources", "value": "DEFAULT"}
          ],
          "arguments": ["-dL", "{target_file}"],
          "output_format": "jsonl"
        },
        {
          "name": "Broad passive",
          "options": [
            {"label": "Sources", "value": "ALL"},
            {"label": "Runtime", "value": "SLOWER"}
          ],
          "arguments": ["-dL", "{target_file}", "-all"],
          "output_format": "jsonl"
        },
        {
          "name": "Recursive passive",
          "arguments": ["-dL", "{target_file}", "-recursive"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "02",
      "eyebrow": "dns",
      "icon": "dns",
      "description": "Resolve Records",
      "summary": "Resolve hosts and enumerate DNS records",
      "bin": "dnsx",
      "path": "dnsx",
      "adapter": "dnsx",
      "config_fields": [
        {
          "id": "resolver",
          "label": "DNS RESOLVER",
          "argument": "-r",
          "placeholder": "dns resolver (optional)"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Standard resolution",
          "options": [
            {"label": "A / AAAA", "value": "ENABLED"},
            {"label": "CNAME", "value": "ENABLED"}
          ],
          "arguments": ["-l", "{target_file}", "-a", "-aaaa", "-cname"],
          "output_format": "jsonl"
        },
        {
          "name": "All records",
          "arguments": ["-l", "{target_file}", "-recon"],
          "output_format": "jsonl"
        },
        {
          "name": "Authority records",
          "arguments": ["-l", "{target_file}", "-ns", "-soa"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "03",
      "eyebrow": "network",
      "icon": "radar",
      "description": "Port Discovery",
      "summary": "Scan ports and fingerprint exposed services",
      "bin": "nmap",
      "path": "nmap",
      "adapter": "nmap",
      "target_summary": "ADD TARGET",
      "target_placeholder": "IP/Host/CIDR",
      "state": "READY",
      "profiles": [
        {
          "name": "Top 1000 TCP",
          "options": [
            {"label": "Scan", "value": "TCP CONNECT"},
            {"label": "Ports", "value": "TOP 1000"}
          ],
          "arguments": ["-sT", "--top-ports", "1000", "--reason", "{targets}"],
          "output_format": "xml"
        },
        {
          "name": "Web ports",
          "arguments": ["-sT", "-p", "80,443,8080,8443", "--reason", "{targets}"],
          "output_format": "xml"
        },
        {
          "name": "Service detection",
          "arguments": ["-sT", "-sV", "--version-light", "--reason", "{targets}"],
          "output_format": "xml"
        }
      ]
    },
    {
      "id": "04",
      "eyebrow": "http",
      "icon": "http",
      "description": "Web Probe",
      "summary": "Probe HTTP services and fingerprint web stacks",
      "bin": "httpx",
      "path": "httpx",
      "adapter": "httpx",
      "config_fields": [
        {
          "id": "resolver",
          "label": "DNS RESOLVER",
          "argument": "-r",
          "placeholder": "optional / e.g. udp:10.64.0.1:53"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "URL/Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Standard web metadata",
          "options": [
            {"label": "Follow redirects", "value": "ENABLED"},
            {"label": "Capture title", "value": "ENABLED"},
            {"label": "Concurrency", "value": "25"}
          ],
          "arguments": ["-u", "{target}", "-title", "-tech-detect", "-fr", "-json"],
          "output_format": "jsonl"
        },
        {
          "name": "Light probe",
          "arguments": ["-u", "{target}", "-status-code", "-title", "-json"],
          "output_format": "jsonl"
        },
        {
          "name": "Extended fingerprint",
          "arguments": ["-u", "{target}", "-status-code", "-title", "-tech-detect", "-web-server", "-ip", "-cname", "-asn", "-cdn", "-location", "-fr", "-json"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "05",
      "eyebrow": "archive",
      "icon": "history",
      "description": "Known URLs",
      "summary": "Lookup known URLs",
      "bin": "gau",
      "path": "gau",
      "adapter": "gau",
      "target_summary": "ADD TARGET",
      "target_placeholder": "Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Common providers",
          "options": [
            {"label": "Subdomains", "value": "ENABLED"},
            {"label": "Parameters", "value": "FOLDED"},
            {"label": "Providers", "value": "ALL"}
          ],
          "arguments": ["--subs", "--fp", "{targets}"],
          "output_format": "jsonl"
        },
        {
          "name": "Wayback only",
          "arguments": ["--providers", "wayback", "{targets}"],
          "output_format": "jsonl"
        },
        {
          "name": "Broad collection",
          "arguments": ["--subs", "{targets}"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "06",
      "eyebrow": "tls",
      "icon": "verified_user",
      "description": "TLS Inspect",
      "summary": "Enumerate TLS certificates and supported ciphers",
      "bin": "tlsx",
      "path": "tlsx",
      "adapter": "tlsx",
      "config_fields": [
        {
          "id": "resolver",
          "label": "DNS RESOLVER",
          "argument": "-r",
          "placeholder": "dns resolver (optional)"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "Domain",
      "state": "READY",
      "profiles": [
        {
          "name": "Certificate summary",
          "options": [
            {"label": "Certificate names", "value": "ENABLED"},
            {"label": "TLS version", "value": "ENABLED"}
          ],
          "arguments": ["-u", "{target}", "-san", "-cn", "-so", "-tls-version", "-cipher"],
          "output_format": "jsonl"
        },
        {
          "name": "Protocol inventory",
          "arguments": ["-u", "{target}", "-version-enum", "-cipher"],
          "output_format": "jsonl"
        },
        {
          "name": "Full TLS metadata",
          "arguments": ["-u", "{target}", "-san", "-cn", "-so", "-tls-version", "-cipher", "-hash", "sha256", "-serial", "-cert", "-tls-chain"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "07",
      "eyebrow": "content",
      "icon": "folder_open",
      "description": "Directory Brute",
      "summary": "Brute directories and files with ffuf",
      "bin": "ffuf",
      "path": "ffuf",
      "adapter": "ffuf",
      "config_fields": [
        {
          "id": "wordlist",
          "label": "WORDLIST",
          "argument": "-w",
          "placeholder": "absolute path to wordlist"
        },
        {
          "id": "recursion_depth",
          "label": "RECURSION DEPTH",
          "argument": "-recursion-depth",
          "placeholder": "1-10"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "HTTP/S URL",
      "state": "READY",
      "profiles": [
        {
          "name": "Directory discovery",
          "arguments": ["-u", "{target}", "-ac"],
          "output_format": "json"
        },
        {
          "name": "Recursive directory discovery",
          "arguments": ["-u", "{target}", "-ac", "-recursion", "-recursion-strategy", "default"],
          "output_format": "json"
        }
      ]
    },
    {
      "id": "08",
      "eyebrow": "attack",
      "icon": "security",
      "description": "Known Vulnerabilities",
      "summary": "Match safe Nuclei templates against web targets",
      "bin": "nuclei",
      "path": "nuclei",
      "adapter": "nuclei",
      "target_summary": "ADD TARGET",
      "target_placeholder": "HTTP/S URL or host",
      "state": "READY",
      "profiles": [
        {
          "name": "Safe known vulnerabilities",
          "options": [
            {"label": "Classification", "value": "SAFE"},
            {"label": "Excluded", "value": "INTRUSIVE / DOS / FUZZ / BRUTE"},
            {"label": "Rate", "value": "10 REQ/S"}
          ],
          "arguments": ["-l", "{target_file}", "-pt", "http", "-etags", "intrusive,dos,fuzz,brute", "-rl", "10", "-c", "5", "-bs", "5", "-duc", "-or"],
          "output_format": "jsonl"
        },
        {
          "name": "Exposure and misconfiguration",
          "options": [
            {"label": "Classification", "value": "SAFE"},
            {"label": "Templates", "value": "EXPOSURE / MISCONFIG"}
          ],
          "arguments": ["-l", "{target_file}", "-pt", "http", "-tags", "exposure,misconfig", "-etags", "intrusive,dos,fuzz,brute", "-rl", "10", "-c", "5", "-bs", "5", "-duc", "-or"],
          "output_format": "jsonl"
        }
      ]
    },
    {
      "id": "09",
      "eyebrow": "attack",
      "icon": "data_object",
      "description": "SQL Injection",
      "summary": "Detect SQL injection without extraction or takeover",
      "bin": "sqlmap",
      "path": ".nullbound-tools/packages/sqlmap/sqlmap.py",
      "adapter": "sqlmap",
      "config_fields": [
        {
          "id": "parameter",
          "label": "PARAMETER (OPTIONAL)",
          "argument": "-p",
          "placeholder": "query or body parameter"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "HTTP/S URL with parameters",
      "state": "READY",
      "profiles": [
        {
          "name": "Low-impact detection",
          "options": [
            {"label": "Classification", "value": "STATEFUL"},
            {"label": "Risk / level", "value": "1 / 1"},
            {"label": "Extraction", "value": "DISABLED"}
          ],
          "arguments": ["-u", "{target}", "--batch", "--level", "1", "--risk", "1", "--technique", "BE", "--threads", "1", "--disable-coloring"],
          "output_format": "text"
        }
      ]
    },
    {
      "id": "10",
      "eyebrow": "attack",
      "icon": "password",
      "description": "Password Validation",
      "summary": "Test capped password candidates with CSRF handling",
      "bin": "brutepyweb",
      "path": "recon_modules/brutepyweb/webbruterv1.py",
      "adapter": "brutepyweb",
      "config_fields": [
        {
          "id": "password_file",
          "label": "PASSWORD WORDLIST",
          "argument": "-p",
          "placeholder": "absolute path to password wordlist"
        },
        {
          "id": "identity",
          "label": "USERNAME / IDENTITY",
          "argument": "--identity",
          "placeholder": "optional evidence identity"
        },
        {
          "id": "threads",
          "label": "THREADS",
          "argument": "--threads",
          "placeholder": "default 5 / max 20"
        },
        {
          "id": "delay",
          "label": "DELAY / SECONDS",
          "argument": "--delay",
          "placeholder": "default 0.5"
        },
        {
          "id": "max_requests",
          "label": "MAX REQUESTS",
          "argument": "--max-requests",
          "placeholder": "default 100 / max 10000"
        }
      ],
      "target_summary": "ADD TARGET",
      "target_placeholder": "HTTP/S login URL",
      "state": "READY",
      "profiles": [
        {
          "name": "Capped CSRF-aware password test",
          "options": [
            {"label": "Classification", "value": "INTRUSIVE"},
            {"label": "CSRF token", "value": "AUTO"},
            {"label": "Candidates", "value": "CAPPED"}
          ],
          "arguments": ["{target}"],
          "output_format": "jsonl"
        }
      ]
    }
  ]
}
